# Coeur.AI Environment Variables Template

# -----------------------------------------------------------------------------
# Python Diagnostic ML Inference Service
# -----------------------------------------------------------------------------
# URL to your running Python FastAPI/Flask inference server
PYTHON_API_URL=http://localhost:8000
NEXT_PUBLIC_PYTHON_API_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Email Dispatcher (Resend API)
# -----------------------------------------------------------------------------
# API key from https://resend.com for handling demo requests and contact forms
RESEND_API_KEY=

# Inbound email recipient for clinical demo requests and contact messages
CONTACT_RECIPIENT_EMAIL=logicboots.officeteam@gmail.com
DEMO_RECIPIENT_EMAIL=logicboots.officeteam@gmail.com

# Verified sender email domain in Resend
RESEND_FROM_EMAIL=Coeur.AI <onboarding@resend.dev>
